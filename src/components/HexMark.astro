---
interface Props {
  class?: string;
  title?: string;
}

const { class: className, title = "Davion Software" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={title}
>
  <polygon
    class="hex-segment"
    points="32,2 57.981,17 42.392,26 32,20"></polygon>
  <polygon
    class="hex-segment"
    points="57.981,17 57.981,47 42.392,38 42.392,26"></polygon>
  <polygon
    class="hex-segment"
    points="57.981,47 32,62 32,44 42.392,38"></polygon>
  <polygon
    class="hex-segment"
    points="32,62 6.019,47 21.608,38 32,44"></polygon>
  <polygon
    class="hex-segment"
    points="6.019,47 6.019,17 21.608,26 21.608,38"></polygon>
  <polygon
    class="hex-segment"
    points="6.019,17 32,2 32,20 21.608,26"></polygon>
  <polygon
    class="hex-core"
    points="32,22.8 39.967,27.4 39.967,36.6 32,41.2 24.033,36.6 24.033,27.4"
  ></polygon>
</svg>

<style>
  .hex-segment {
    fill: #2f333c;
    stroke: #0a0a0a;
    stroke-width: 1.25;
    stroke-linejoin: round;
  }

  .hex-core {
    fill: #d1a744;
  }
</style>
