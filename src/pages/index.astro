---
import Button from "../components/Button.astro";
import CapabilityIconGlyph from "../components/CapabilityIconGlyph.astro";
import FaqList from "../components/FaqList.astro";
import HeroVisual from "../components/HeroVisual.astro";
import Layout from "../layouts/Layout.astro";
import TaglineReveal from "../components/TaglineReveal.astro";
import {
  capabilities,
  capabilitiesHeading,
  coda,
  faq,
  faqHeading,
  home,
  links,
  principles,
  process,
  processHeading,
  tagline,
} from "../content/home";

export const prerender = true;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Davion Software",
  url: "https://davionsoftware.com",
  email: "hola@davionsoftware.com",
  areaServed: "PE",
  description: home.oneLiner,
  sameAs: [links.github],
};
---

<Layout>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section>
    <div
      class="mx-auto grid w-full max-w-6xl items-center gap-12 px-6 pt-12 pb-16 sm:px-8 lg:grid-cols-12 lg:gap-8 lg:py-16"
    >
      <div class="flex flex-col lg:col-span-7">
        <p class="flex items-center gap-2 text-sm text-ink-tertiary">
          <span
            aria-hidden="true"
            class="inline-block size-2 rounded-full bg-gold"></span>
          {home.availability}
        </p>
        <h1
          class="mt-6 flex max-w-2xl flex-col gap-3 text-3xl leading-none font-medium tracking-tight sm:text-5xl lg:max-w-none"
        >
          <span>{home.heroLead}</span>
          <span class="text-ink-secondary">{home.heroTail}</span>
        </h1>
        <p
          class="mt-6 max-w-xl text-base leading-relaxed text-pretty text-ink-secondary sm:text-xl"
        >
          {home.oneLiner}
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          {
            links.calendar ? (
              <>
                <Button variant="primary" href={links.calendar} rel="noopener noreferrer" target="_blank">
                  {home.primaryCta}
                </Button>
                <Button variant="secondary" href={links.whatsappDiagnostic} rel="noopener noreferrer" target="_blank">
                  {home.whatsappCta}
                </Button>
              </>
            ) : (
              <>
                <Button variant="primary" href={links.whatsappDiagnostic} rel="noopener noreferrer" target="_blank">
                  {home.primaryCta}
                </Button>
                <Button variant="secondary" href="#capacidades">
                  {home.capabilitiesCta}
                </Button>
              </>
            )
          }
        </div>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-pretty text-ink-tertiary">
          {home.heroProof}
        </p>
      </div>
      <div class="lg:col-span-5">
        <HeroVisual />
      </div>
    </div>
  </section>

  <TaglineReveal lines={tagline.lines} />

  <section
    id="estudio"
    class="mx-auto w-full max-w-6xl scroll-mt-24 px-6 py-24 sm:px-8"
  >
    <h2
      class="max-w-2xl text-3xl leading-none font-medium tracking-tight text-balance sm:text-4xl"
    >
      {home.who}
    </h2>
    <p
      class="mt-8 max-w-2xl text-lg leading-relaxed text-pretty text-ink-secondary"
    >
      {home.studioBody}
    </p>
    <ul class="reveal mt-12 grid gap-8 md:grid-cols-3">
      {
        principles.map((principle) => (
          <li data-reveal-item class="border-t border-line pt-6">
            <h3 class="text-lg font-medium tracking-tight text-soft-white">
              {principle.title}
            </h3>
            <p class="mt-2 text-base leading-relaxed text-pretty text-ink-secondary">
              {principle.description}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    id="capacidades"
    class="mx-auto w-full max-w-6xl scroll-mt-24 px-6 py-24 sm:px-8"
  >
    <h2 class="text-3xl leading-none font-medium tracking-tight sm:text-4xl">
      {capabilitiesHeading}
    </h2>
    <ul class="reveal mt-12 grid auto-rows-fr gap-4 md:grid-cols-2">
      {
        capabilities.map((capability, index) => (
          <li
            data-reveal-item
            class:list={[
              "flex flex-col rounded-xl border border-line bg-charcoal p-6",
              index === capabilities.length - 1 &&
                capabilities.length % 2 === 1 &&
                "md:col-span-2",
            ]}
          >
            <CapabilityIconGlyph name={capability.icon} />
            <h3 class="mt-5 text-xl font-medium tracking-tight text-soft-white">
              {capability.name}
            </h3>
            <p class="mt-3 text-base leading-relaxed text-pretty text-soft-white">
              {capability.pain}
            </p>
            <p class="mt-3 text-base leading-relaxed text-pretty text-ink-secondary">
              {capability.delivery}
            </p>
            {capability.tools.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-2">
                {capability.tools.map((tool) => (
                  <li class="rounded-full border border-line px-3 py-1 text-sm text-ink-secondary">
                    {tool}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section
    id="como-trabajamos"
    class="mx-auto w-full max-w-6xl scroll-mt-24 px-6 py-24 sm:px-8"
  >
    <h2 class="text-3xl leading-none font-medium tracking-tight sm:text-4xl">
      {processHeading}
    </h2>
    <ol class="reveal mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        process.map((step, index) => (
          <li
            data-reveal-item
            class="flex flex-col rounded-xl border border-line bg-charcoal p-6"
          >
            <span aria-hidden="true" class="text-sm font-medium tracking-widest text-gold">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-4 text-xl font-medium tracking-tight text-soft-white">
              {step.title}
            </h3>
            <p class="mt-3 text-base leading-relaxed text-pretty text-ink-secondary">
              {step.description}
            </p>
            <p class="mt-auto pt-5 text-base leading-relaxed text-pretty text-soft-white">
              <span class="font-medium">Usted recibe:</span> {step.receive}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <section
    id="preguntas"
    class="mx-auto w-full max-w-6xl scroll-mt-24 px-6 py-24 sm:px-8"
  >
    <h2 class="max-w-2xl text-3xl leading-none font-medium tracking-tight text-balance sm:text-4xl">
      {faqHeading}
    </h2>
    <FaqList items={faq} />
  </section>

  <section id="contacto" class="scroll-mt-24 bg-soft-white text-charcoal">
    <div class="mx-auto w-full max-w-6xl px-6 py-24 sm:px-8">
      <div class="max-w-2xl">
        <h2
          class="flex max-w-2xl flex-col gap-4 text-3xl leading-none font-medium tracking-tight sm:text-4xl"
        >
          <span>{coda.headingLead}</span>
          <span class="text-ink-on-light-secondary">{coda.headingTail}</span>
        </h2>
        <p
          class="mt-8 max-w-2xl text-lg leading-relaxed text-pretty text-ink-on-light-secondary"
        >
          {coda.support}
        </p>
        <p
          class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-on-light-secondary"
        >
          {coda.riskReversal}
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <Button
            variant="primary"
            href={links.whatsapp}
            rel="noopener noreferrer"
            target="_blank"
          >
            {coda.action}
          </Button>
          <Button variant="secondary" surface="light" href={links.email}>
            {coda.emailAction}
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>
