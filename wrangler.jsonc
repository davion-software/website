{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "davion-software-website",
  // Astro 6+/7 official Cloudflare adapter entrypoint (not dist/_worker.js).
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Production on the Cloudflare zone. workers.dev remains for preview.
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "davionsoftware.com", "custom_domain": true },
    { "pattern": "www.davionsoftware.com", "custom_domain": true }
  ],
  "assets": {
    // After `astro build`, Wrangler redirects this to dist/client.
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
