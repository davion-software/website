---
import Button from "../components/Button.astro";
import HexMark from "../components/HexMark.astro";
import Layout from "../layouts/Layout.astro";
import { capabilities, home, links, principles } from "../content/home";

export const prerender = true;

const chapters = [
  { id: "estudio", index: "01", label: "Estudio" },
  { id: "para-quien", index: "02", label: "Para quién" },
  { id: "capacidades", index: "03", label: "Capacidades" },
] as const;
---

<Layout>
  <section class="relative overflow-hidden">
    <div
      aria-hidden="true"
      class="mark-enter pointer-events-none absolute inset-y-0 right-0 hidden w-[30rem] items-center justify-end lg:flex"
    >
      <HexMark class="h-[24rem] w-[24rem] translate-x-20 xl:h-[27rem] xl:w-[27rem]" title="" />
    </div>
    <div
      class="relative mx-auto w-full max-w-6xl px-6 pt-16 pb-16 sm:px-8 lg:pt-24 lg:pb-24"
    >
      <p class="rise flex items-center gap-2.5 text-sm font-medium text-ink-tertiary">
        <span aria-hidden="true" class="inline-block size-1.5 rounded-full bg-gold"></span>
        Aceptando nuevos proyectos
      </p>
      <h1
        class="rise rise-2 mt-6 max-w-[38rem] text-4xl leading-[1.08] font-medium tracking-tight text-balance sm:text-5xl sm:text-6xl"
      >
        {home.hero}
      </h1>
      <p
        class="rise rise-3 mt-8 max-w-[34rem] text-lg leading-relaxed text-ink-secondary sm:text-xl"
      >
        {home.oneLiner}
      </p>
      <div class="rise rise-4 mt-10 flex flex-wrap gap-4">
        <Button variant="primary" href="#capacidades">Ver capacidades</Button>
        <Button variant="secondary" href="#estudio">Conocer el estudio</Button>
      </div>
    </div>
  </section>

  <section id="estudio" class="mx-auto w-full max-w-6xl px-6 py-16 sm:px-8 lg:py-24">
    <div class="reveal grid gap-10 lg:grid-cols-12 lg:gap-12">
      <h2 class="flex items-baseline gap-3 text-sm font-medium lg:col-span-4">
        <span class="tabular-nums text-gold">{chapters[0].index}</span>
        <span class="text-ink-tertiary">{chapters[0].label}</span>
      </h2>
      <div class="max-w-[42rem] lg:col-span-8">
        <p class="text-xl leading-relaxed text-soft-white sm:text-2xl sm:leading-relaxed">
          {home.who}
        </p>
        <dl class="mt-12 grid gap-10 sm:grid-cols-3 sm:gap-8">
          {
            principles.map((principle) => (
              <div data-reveal-item>
                <dt class="text-base font-medium text-soft-white">{principle.title}</dt>
                <dd class="mt-2 text-sm leading-relaxed text-ink-secondary">
                  {principle.description}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section
    id="para-quien"
    class="mx-auto w-full max-w-6xl px-6 py-16 sm:px-8 lg:py-24"
  >
    <div class="reveal grid gap-10 lg:grid-cols-12 lg:gap-12">
      <h2 class="flex items-baseline gap-3 text-sm font-medium lg:col-span-4">
        <span class="tabular-nums text-gold">{chapters[1].index}</span>
        <span class="text-ink-tertiary">{chapters[1].label}</span>
      </h2>
      <div class="max-w-[42rem] lg:col-span-8">
        <p class="text-xl leading-relaxed text-soft-white sm:text-2xl sm:leading-relaxed">
          {home.audienceLead}
        </p>
        <p class="mt-6 text-lg leading-relaxed text-ink-secondary">
          {home.audienceDetail}
        </p>
        <p class="mt-4 max-w-prose text-base leading-relaxed text-ink-secondary">
          {home.audienceBridge}
        </p>
      </div>
    </div>
  </section>

  <section
    id="capacidades"
    class="mx-auto w-full max-w-6xl px-6 py-16 sm:px-8 lg:py-24"
  >
    <div class="reveal">
      <h2 class="flex items-baseline gap-3 text-sm font-medium">
        <span class="tabular-nums text-gold">{chapters[2].index}</span>
        <span class="text-ink-tertiary">{chapters[2].label}</span>
      </h2>
      <ol class="mt-12 space-y-12 lg:space-y-14">
        {
          capabilities.map((capability, index) => (
            <li data-reveal-item class="grid gap-3 lg:grid-cols-12 lg:gap-12">
              <div class="lg:col-span-5">
                <p class="text-sm tabular-nums text-gold">
                  {String(index + 1).padStart(2, "0")}
                </p>
                <h3 class="mt-2 text-xl font-medium tracking-tight text-soft-white">
                  {capability.name}
                </h3>
              </div>
              <p class="max-w-[36rem] text-base leading-relaxed text-ink-secondary lg:col-span-7 lg:pt-7">
                {capability.description}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-soft-white text-charcoal">
    <div class="mx-auto w-full max-w-6xl px-6 py-20 sm:px-8 lg:py-28">
      <div class="reveal max-w-[42rem]">
        <h2 class="text-sm font-medium text-[rgb(23_29_38/0.52)]">Empecemos</h2>
        <p class="mt-8 text-3xl leading-tight font-medium tracking-tight text-balance sm:text-5xl sm:leading-[1.08]">
          Cuéntenos qué le quita tiempo
          <span class="text-[rgb(23_29_38/0.68)]">a su equipo.</span>
        </p>
        <p class="mt-8 max-w-prose text-lg leading-relaxed text-[rgb(23_29_38/0.68)]">
          Actualmente aceptamos nuevos proyectos. El primer paso es una
          conversación breve sobre su operación actual y lo que necesita resolver.
        </p>
        <div class="mt-10">
          <Button
            variant="primary"
            href={links.github}
            rel="noopener"
          >
            Iniciar una conversación
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>
