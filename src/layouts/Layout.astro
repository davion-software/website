---
import { Font } from "astro:assets";
import Lockup from "../components/Lockup.astro";
import { brand, company, home, links, nav } from "../content/home";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${brand.name}. Estudio de software independiente en Perú`,
  description = home.oneLiner,
} = Astro.props;

const year = new Date().getFullYear();
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://davionsoftware.com");
const ogImage = new URL("/og.png", canonical).href;
const footerLink =
  "link-quiet inline-flex min-h-11 items-center text-ink-secondary underline-offset-4 transition-[color] duration-150 ease-out-quart hover:underline";
const ogImageAlt = `${brand.name}: ${home.heroLead} ${home.heroTail}`;
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={brand.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <Font cssVariable="--font-inter" preload />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class="min-h-dvh bg-surface-0 font-sans text-ink">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-surface-2 focus:px-4 focus:py-3 focus:text-sm focus:font-semibold"
    >
      Saltar al contenido
    </a>
    <header class="sticky top-0 z-20 border-b border-border bg-surface-0/90 backdrop-blur-md">
      <div
        class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between px-6 sm:px-8 md:h-16 md:flex-nowrap"
      >
        <Lockup />
        <button
          type="button"
          data-menu-button
          aria-expanded="false"
          aria-controls="menu-principal"
          class="menu-button btn-secondary h-11 items-center rounded-lg border border-border-strong px-4 text-sm font-semibold text-ink"
        >
          Menú
        </button>
        <nav
          id="menu-principal"
          data-menu
          aria-label="Principal"
          class="site-nav flex w-full flex-wrap items-center gap-x-6 text-sm font-medium md:w-auto"
        >
          {
            nav.map((item) => (
              <a
                href={isHome ? item.href : `/${item.href}`}
                data-nav-link={isHome ? item.href : undefined}
                class="link-quiet inline-flex min-h-11 items-center text-ink-secondary transition-[color] duration-150 ease-out-quart"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="border-t border-border">
      <div class="mx-auto w-full max-w-6xl px-6 py-12 sm:px-8">
        <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
          <div class="flex max-w-sm flex-col gap-4">
            <Lockup />
            <p class="text-sm text-ink-secondary">{home.footerStudio}</p>
            <p class="text-sm text-ink-tertiary">{company.country}</p>
          </div>
          <nav aria-label="Pie de página" class="grid grid-cols-2 gap-8">
            <ul class="flex flex-col text-sm">
              <li>
                <a href={links.email} class={footerLink}>{links.emailAddress}</a>
              </li>
              <li>
                <a href={links.whatsapp} rel="noopener noreferrer" target="_blank" class={footerLink}>
                  WhatsApp
                </a>
              </li>
              <li>
                <a href={links.github} rel="me noopener" class={footerLink}>GitHub</a>
              </li>
              {
                company.linkedin && (
                  <li>
                    <a href={company.linkedin} rel="me noopener" class={footerLink}>
                      LinkedIn
                    </a>
                  </li>
                )
              }
            </ul>
            <ul class="flex flex-col text-sm">
              <li><a href="/privacidad" class={footerLink}>Privacidad</a></li>
              <li><a href="/terminos" class={footerLink}>Términos</a></li>
            </ul>
          </nav>
        </div>
        <p class="mt-8 text-sm text-ink-tertiary">
          © {year} Davion Software{company.ruc && ` · RUC ${company.ruc}`}
        </p>
      </div>
    </footer>
    <script>
      const revealables = document.querySelectorAll(".reveal");
      if (!("IntersectionObserver" in window)) {
        revealables.forEach((element) => element.setAttribute("data-visible", ""));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.setAttribute("data-visible", "");
                revealObserver.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0 },
        );
        revealables.forEach((element) => revealObserver.observe(element));
      }

      const menuButton = document.querySelector<HTMLButtonElement>("[data-menu-button]");
      const menu = document.querySelector<HTMLElement>("[data-menu]");
      if (menuButton && menu) {
        const setOpen = (open: boolean, restoreFocus = false) => {
          menu.toggleAttribute("data-open", open);
          menuButton.setAttribute("aria-expanded", String(open));
          if (open) menu.querySelector<HTMLElement>("a")?.focus({ preventScroll: true });
          else if (restoreFocus) menuButton.focus();
        };
        const isOpen = () => menu.hasAttribute("data-open");
        menuButton.addEventListener("click", () => setOpen(!isOpen()));
        menu.addEventListener("click", (event) => {
          if ((event.target as Element).closest("a")) setOpen(false);
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && isOpen()) setOpen(false, true);
        });
        document.addEventListener("click", (event) => {
          const target = event.target as Node;
          if (isOpen() && !menu.contains(target) && !menuButton.contains(target)) setOpen(false);
        });
      }

      const navLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
      );
      const sections = navLinks
        .map((link) => {
          const id = link.dataset.navLink;
          if (!id) return null;
          const section = document.querySelector(id);
          return section ? { link, section } : null;
        })
        .filter((item): item is { link: HTMLAnchorElement; section: Element } =>
          Boolean(item),
        );

      if (sections.length > 0 && "IntersectionObserver" in window) {
        const activate = (active: HTMLAnchorElement | null) => {
          for (const { link } of sections) {
            if (link === active) {
              link.setAttribute("aria-current", "location");
            } else {
              link.removeAttribute("aria-current");
            }
          }
        };

        const spy = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
            if (!visible) return;
            const match = sections.find(({ section }) => section === visible.target);
            if (match) activate(match.link);
          },
          { rootMargin: "-30% 0px -50% 0px", threshold: [0.1, 0.35, 0.6] },
        );

        sections.forEach(({ section }) => spy.observe(section));
      }

      const taglineSection = document.getElementById("tagline");
      if (taglineSection) {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduceMotion || !("IntersectionObserver" in window)) {
          taglineSection.setAttribute("data-visible", "");
        } else {
          const taglineObserver = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.setAttribute("data-visible", "");
                taglineObserver.unobserve(entry.target);
              }
            },
            { root: null, rootMargin: "0px 0px -30% 0px", threshold: 0 },
          );
          taglineObserver.observe(taglineSection);
        }
      }

      const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-email]");
      const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");
      const copyLabel = copyButton?.querySelector<HTMLElement>("[data-copy-label]");
      const copyIdleIcon = copyButton?.querySelector("[data-copy-icon='idle']");
      const copyDoneIcon = copyButton?.querySelector("[data-copy-icon='done']");
      if (copyButton && copyStatus && copyLabel) {
        const idleLabel = copyLabel.textContent ?? "";
        let copyTimer: number | undefined;
        const showCopyState = (message: string, copied: boolean) => {
          copyLabel.textContent = message;
          copyStatus.textContent = message === idleLabel ? "" : message;
          copyIdleIcon?.classList.toggle("hidden", copied);
          copyDoneIcon?.classList.toggle("hidden", !copied);
        };
        copyButton.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(copyButton.dataset.copyEmail ?? "");
            showCopyState(copyButton.dataset.copied ?? "", true);
          } catch {
            showCopyState(copyButton.dataset.failed ?? "", false);
          }
          window.clearTimeout(copyTimer);
          copyTimer = window.setTimeout(() => showCopyState(idleLabel, false), 2500);
        });
      }
    </script>
  </body>
</html>
