---
import { Image } from "astro:assets";
import mark from "../assets/mark.webp";
import { brand } from "../content/home";

interface Props {
  href?: string;
}

const { href = "/" } = Astro.props;
---

<a href={href} class="inline-flex items-center gap-3 no-underline">
  <Image
    src={mark}
    alt=""
    width={36}
    height={36}
    densities={[1, 2]}
    class="size-9 shrink-0"
  />
  <span class="flex flex-col leading-none">
    <span class="font-medium tracking-tight text-soft-white">{brand.lockupWordmark}</span>
    <span class="mt-1 text-[0.65rem] font-medium tracking-[0.28em] text-gold">
      {brand.lockupCategory}
    </span>
  </span>
</a>
