---
import { Image } from "astro:assets";
import mark from "../assets/mark.webp";
import Button from "../components/Button.astro";
import FaqList from "../components/FaqList.astro";
import Layout from "../layouts/Layout.astro";
import TaglineReveal from "../components/TaglineReveal.astro";
import {
  benefits,
  benefitsHeading,
  capabilities,
  capabilitiesHeading,
  coda,
  faq,
  faqHeading,
  home,
  links,
  principles,
  processHeading,
  tagline,
} from "../content/home";

export const prerender = true;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Davion Software",
  url: "https://davionsoftware.com",
  email: "hola@davionsoftware.com",
  areaServed: "PE",
  description: home.oneLiner,
  sameAs: [links.github],
};
---

<Layout>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="lg:flex lg:min-h-[calc(100dvh-4rem)] lg:items-center">
    <div
      class="mx-auto grid w-full max-w-6xl items-center px-6 pt-16 pb-20 sm:px-8 lg:grid-cols-12 lg:gap-12 lg:py-16"
    >
      <div class="flex flex-col lg:col-span-8">
        <p class="rise flex items-center gap-2 text-sm text-ink-tertiary">
          <span
            aria-hidden="true"
            class="inline-block size-2 rounded-full bg-gold"></span>
          {home.availability}
        </p>
        <h1
          class="rise rise-2 mt-6 flex max-w-2xl flex-col gap-4 text-3xl leading-none font-medium tracking-tight sm:text-5xl lg:max-w-none lg:text-6xl"
        >
          <span class="lg:whitespace-nowrap">{home.heroLead}</span>
          <span class="text-ink-secondary lg:whitespace-nowrap">{home.heroTail}</span>
        </h1>
        <p
          class="rise rise-3 mt-8 max-w-2xl text-base leading-relaxed text-pretty text-ink-secondary sm:text-xl"
        >
          {home.oneLiner}
        </p>
        <p class="rise rise-4 mt-4 max-w-2xl text-sm leading-relaxed text-pretty text-ink-tertiary">
          {home.heroProof}
        </p>
        <div class="rise rise-4 mt-10">
          <Button
            variant="primary"
            href={links.whatsapp}
            rel="noopener noreferrer"
            target="_blank"
          >
            {home.primaryCta}
          </Button>
        </div>
      </div>
      <div class="mark-enter mt-16 hidden justify-end lg:col-span-4 lg:mt-0 lg:flex">
        <Image
          src={mark}
          alt=""
          width={224}
          height={224}
          loading="eager"
          fetchpriority="high"
          densities={[1, 2]}
          class="size-56"
        />
      </div>
    </div>
  </section>

  <TaglineReveal lines={tagline.lines} />

  <section
    id="estudio"
    class="mx-auto w-full max-w-6xl scroll-mt-24 px-6 py-24 sm:px-8"
  >
    <h2
      class="max-w-2xl text-3xl leading-none font-medium tracking-tight text-balance sm:text-4xl"
    >
      {home.who}
    </h2>
    <p
      class="mt-8 max-w-2xl text-lg leading-relaxed text-pretty text-ink-secondary"
    >
      {home.audienceLead}{" "}{home.audienceDetail}
    </p>
    <p
      class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-secondary"
    >
      {home.audienceBridge}
    </p>
  </section>

  <section class="mx-auto w-full max-w-6xl px-6 py-24 sm:px-8">
    <h2 class="max-w-2xl text-3xl leading-none font-medium tracking-tight text-balance sm:text-4xl">
      {benefitsHeading}
    </h2>
    <ul class="reveal mt-16 grid gap-16 md:grid-cols-2">
      {
        benefits.map((benefit, index) => (
          <li
            data-reveal-item
            class:list={[index === 0 ? "max-w-2xl md:col-span-2" : "max-w-xl"]}
          >
            <h3 class="text-xl font-medium tracking-tight text-soft-white sm:text-2xl">
              {benefit.title}
            </h3>
            <p class="mt-4 text-base leading-relaxed text-pretty text-ink-secondary">
              {benefit.description}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    id="proceso"
    class="mx-auto w-full max-w-6xl scroll-mt-24 px-6 py-24 sm:px-8"
  >
    <h2 class="max-w-2xl text-3xl leading-none font-medium tracking-tight text-balance sm:text-4xl">
      {processHeading}
    </h2>
    <ol class="reveal mt-16 flex flex-col gap-16">
      {
        principles.map((step) => (
          <li
            data-reveal-item
            class="grid gap-4 lg:grid-cols-12 lg:gap-16"
          >
            <h3 class="text-xl font-medium tracking-tight text-soft-white sm:text-2xl lg:col-span-5">
              {step.title}
            </h3>
            <p class="max-w-2xl text-base leading-relaxed text-pretty text-ink-secondary lg:col-span-7">
              {step.description}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <section
    id="capacidades"
    class="mx-auto w-full max-w-6xl scroll-mt-24 px-6 py-24 sm:px-8"
  >
    <h2 class="text-3xl leading-none font-medium tracking-tight sm:text-4xl">
      {capabilitiesHeading}
    </h2>
    <ul class="reveal mt-16 grid gap-16 sm:grid-cols-2">
      {
        capabilities.map((capability) => (
          <li data-reveal-item class="max-w-xl">
            <h3 class="text-xl font-medium tracking-tight text-soft-white sm:text-2xl">
              {capability.name}
            </h3>
            <p class="mt-4 text-base leading-relaxed text-pretty text-ink-secondary">
              {capability.description}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    id="preguntas"
    class="mx-auto w-full max-w-6xl scroll-mt-24 px-6 py-24 sm:px-8"
  >
    <h2 class="max-w-2xl text-3xl leading-none font-medium tracking-tight text-balance sm:text-4xl">
      {faqHeading}
    </h2>
    <FaqList items={faq} />
  </section>

  <section id="contacto" class="scroll-mt-24 bg-soft-white text-charcoal">
    <div class="mx-auto w-full max-w-6xl px-6 py-24 sm:px-8">
      <div class="max-w-2xl">
        <h2
          class="flex max-w-2xl flex-col gap-4 text-3xl leading-none font-medium tracking-tight sm:text-4xl"
        >
          <span>{coda.headingLead}</span>
          <span class="text-ink-on-light-secondary">{coda.headingTail}</span>
        </h2>
        <p
          class="mt-8 max-w-2xl text-lg leading-relaxed text-pretty text-ink-on-light-secondary"
        >
          {coda.support}
        </p>
        <p
          class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-ink-on-light-secondary"
        >
          {coda.riskReversal}
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <Button
            variant="primary"
            href={links.whatsapp}
            rel="noopener noreferrer"
            target="_blank"
          >
            {coda.action}
          </Button>
          <Button variant="secondary" surface="light" href={links.email}>
            {coda.emailAction}
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>
