---
const rows = [
  { label: "Pendiente", tone: "idle", main: 78, side: 40 },
  { label: "En curso", tone: "active", main: 62, side: 52 },
  { label: "Listo", tone: "done", main: 90, side: 34 },
] as const;
---

<rect x="241" y="31" width="238" height="198" rx="12" class="fill-surface-1 stroke-steel" />
<path
  d="M253 31h40v198h-40a12 12 0 0 1-12-12V43a12 12 0 0 1 12-12Z"
  class="fill-surface-0"
></path>
<rect x="255" y="47" width="22" height="22" rx="6" class="fill-accent"></rect>
<rect x="255" y="85" width="22" height="4" rx="2" class="fill-steel"></rect>
<rect x="255" y="103" width="22" height="4" rx="2" class="fill-steel"></rect>
<rect x="255" y="121" width="22" height="4" rx="2" class="fill-steel"></rect>
<rect x="311" y="47" width="86" height="10" rx="5" class="fill-ink/70"></rect>
<rect x="311" y="65" width="52" height="6" rx="3" class="fill-ink/25"></rect>
{
  rows.map((row, index) => {
    const y = 90 + index * 44;
    return (
      <g>
        <rect x="311" y={y} width="156" height="34" rx="8" class="fill-surface-0/60 stroke-steel" />
        <rect x="323" y={y + 10} width={row.main * 0.7} height="6" rx="3" class="fill-ink/50"></rect>
        <rect x="323" y={y + 20} width={row.side * 0.7} height="4" rx="2" class="fill-ink/20"></rect>
        <rect
          x="405"
          y={y + 8}
          width="54"
          height="18"
          rx="9"
          class:list={[
            row.tone === "idle" && "fill-steel",
            row.tone === "active" && "fill-accent/25",
            row.tone === "done" && "fill-accent",
          ]}
        />
        <text
          x="432"
          y={y + 20.5}
          text-anchor="middle"
          font-size="9"
          font-weight="600"
          class:list={[
            row.tone === "idle" && "fill-ink/70",
            row.tone === "active" && "fill-accent",
            row.tone === "done" && "fill-surface-0",
          ]}
        >
          {row.label}
        </text>
      </g>
    );
  })
}
