---
import Button from "../components/Button.astro";
import CapabilityIconGlyph from "../components/CapabilityIconGlyph.astro";
import FaqList from "../components/FaqList.astro";
import Founder from "../components/Founder.astro";
import HeroVisual from "../components/HeroVisual.astro";
import Layout from "../layouts/Layout.astro";
import Projects from "../components/Projects.astro";
import Section from "../components/Section.astro";
import Testimonials from "../components/Testimonials.astro";
import TaglineReveal from "../components/TaglineReveal.astro";
import {
  brand,
  capabilities,
  capabilitiesHeading,
  coda,
  faq,
  faqHeading,
  founder,
  home,
  links,
  principles,
  process,
  processHeading,
  tagline,
} from "../content/home";

export const prerender = true;

const faqSchema = {
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const siteUrl = "https://davionsoftware.com";
const orgSchema = {
  "@type": "ProfessionalService",
  name: brand.name,
  url: siteUrl,
  email: links.emailAddress,
  telephone: "+51996004562",
  logo: `${siteUrl}/favicon.png`,
  image: `${siteUrl}/og.png`,
  description: home.oneLiner,
  areaServed: "PE",
  address: { "@type": "PostalAddress", addressCountry: "PE" },
  sameAs: [links.github],
  ...(founder.enabled && {
    founder: {
      "@type": "Person",
      name: founder.name,
      jobTitle: founder.role,
      url: founder.links[2].href,
      sameAs: [founder.links[0].href, founder.links[1].href],
    },
  }),
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [orgSchema, faqSchema],
};
---

<Layout>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Section tone="base" compact>
    <div
      class="grid items-center gap-8 pt-8 pb-12 md:gap-12 md:pt-12 md:pb-16 lg:grid-cols-[minmax(0,1fr)_30rem] lg:gap-8 lg:py-16 xl:-mr-[min(6rem,calc((100vw-68rem)/2-1rem))] xl:grid-cols-[minmax(0,1fr)_31rem]"
    >
      <div class="flex flex-col">
        <p class="flex items-center gap-2 text-sm text-ink-tertiary">
          <span aria-hidden="true" class="inline-block size-2 rounded-full bg-accent"></span>
          {home.availability}
        </p>
        <h1
          class="mt-6 flex max-w-2xl flex-col gap-3 text-title leading-none font-medium tracking-tight lg:max-w-none xl:text-display"
        >
          <span class="text-balance">{home.heroLead}</span>
          <span class="text-balance text-ink-secondary">{home.heroTail}</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-pretty text-ink-secondary">
          {home.oneLiner}
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:flex-col lg:items-start xl:flex-row">
          {
            links.calendar ? (
              <>
                <Button variant="primary" href={links.calendar} rel="noopener noreferrer" target="_blank">
                  {home.primaryCta}
                </Button>
                <Button variant="secondary" href={links.whatsappDiagnostic} rel="noopener noreferrer" target="_blank">
                  {home.whatsappCta}
                </Button>
              </>
            ) : (
              <>
                <Button variant="primary" href={links.whatsappDiagnostic} rel="noopener noreferrer" target="_blank">
                  {home.primaryCta}
                </Button>
                <Button variant="secondary" href="#capacidades">
                  {home.capabilitiesCta}
                </Button>
              </>
            )
          }
        </div>
        <p class="mt-4 max-w-xl text-sm text-pretty text-ink-tertiary">
          {home.heroProof}
        </p>
      </div>
      <div>
        <HeroVisual />
      </div>
    </div>
  </Section>

  <TaglineReveal lines={tagline.lines} />

  <Section id="capacidades" tone="base">
    <h2 class="text-heading leading-tight font-medium tracking-tight md:text-title">
      {capabilitiesHeading}
    </h2>
    <ul class="reveal mt-12 grid gap-4 md:grid-cols-2">
      {
        capabilities.map((capability, index) => {
          const wide = index === capabilities.length - 1 && capabilities.length % 2 === 1;
          return (
            <li
              data-reveal-item
              class:list={[
                "flex flex-col rounded-xl border border-border bg-(--card-bg) p-6",
                wide && "md:col-span-2 md:grid md:grid-cols-2 md:gap-x-12",
              ]}
            >
              <div class:list={["contents", wide && "md:block"]}>
                <CapabilityIconGlyph name={capability.icon} />
                <h3 class="mt-4 text-lg font-semibold tracking-tight text-ink">
                  {capability.name}
                </h3>
                <p class="mt-3 text-base text-pretty text-ink">
                  {capability.pain}
                </p>
              </div>
              <div class:list={["contents", wide && "md:block"]}>
                <p
                  class:list={[
                    "mt-3 text-base text-pretty text-ink-secondary",
                    wide && "md:mt-12",
                  ]}
                >
                  {capability.delivery}
                </p>
                {capability.tools.length > 0 && (
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {capability.tools.map((tool) => (
                      <li class="rounded-full border border-border px-3 py-1 text-sm text-ink-secondary">
                        {tool}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
  </Section>

  <Section id="como-trabajamos" tone="raised">
    <h2 class="text-heading leading-tight font-medium tracking-tight md:text-title">
      {processHeading}
    </h2>
    <ol class="reveal mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        process.map((step, index) => (
          <li
            data-reveal-item
            class="flex flex-col rounded-xl border border-border bg-(--card-bg) p-6"
          >
            <span aria-hidden="true" class="text-sm font-medium tracking-widest text-accent">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-4 text-lg font-semibold tracking-tight text-ink">
              {step.title}
            </h3>
            <p class="mt-3 text-base text-pretty text-ink-secondary">
              {step.description}
            </p>
            <p class="mt-auto pt-4 text-base text-ink">
              <span class="font-semibold">Usted recibe:</span> {step.receive}
            </p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Projects tone="base" />

  <Section id="estudio" tone="base">
    <h2 class="max-w-2xl text-heading leading-tight font-medium tracking-tight text-balance md:text-title">
      {home.who}
    </h2>
    <p class="mt-6 max-w-2xl text-lg text-pretty text-ink-secondary">
      {home.studioBody}
    </p>
    <ul class="reveal mt-12 grid gap-8 md:grid-cols-3">
      {
        principles.map((principle) => (
          <li data-reveal-item class="border-t border-border pt-6">
            <h3 class="text-lg font-semibold tracking-tight text-ink">
              {principle.title}
            </h3>
            <p class="mt-2 text-base text-pretty text-ink-secondary">
              {principle.description}
            </p>
          </li>
        ))
      }
    </ul>
    <Founder />
  </Section>

  <Testimonials tone="raised" />

  <Section id="preguntas" tone="raised">
    <h2 class="max-w-2xl text-heading leading-tight font-medium tracking-tight text-balance md:text-title">
      {faqHeading}
    </h2>
    <FaqList items={faq} />
  </Section>

  <Section id="contacto" tone="light">
    <div class="max-w-2xl">
      <h2 class="text-heading leading-tight font-medium tracking-tight text-balance md:text-title">
        {coda.heading}
      </h2>
      <p class="mt-6 text-lg text-pretty text-ink-on-light-secondary">
        {coda.support}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button
          variant="primary"
          href={links.whatsappDiagnostic}
          rel="noopener noreferrer"
          target="_blank"
        >
          {home.whatsappCta}
        </Button>
        {
          links.calendar && (
            <Button
              variant="secondary"
              surface="light"
              href={links.calendar}
              rel="noopener noreferrer"
              target="_blank"
            >
              {coda.calendarAction}
            </Button>
          )
        }
      </div>
      <p class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2 text-base text-ink-on-light-secondary">
        <span>{coda.emailLabel}</span>
        <a
          href={links.email}
          class="inline-flex min-h-11 items-center font-medium text-ink-on-light underline underline-offset-4"
        >
          {links.emailAddress}
        </a>
        <button
          type="button"
          data-copy-email={links.emailAddress}
          data-copied={coda.copied}
          data-failed={coda.copyFailed}
          class="js-only btn-secondary-on-light h-11 items-center rounded-lg border border-border-strong-light px-4 text-sm font-semibold text-ink-on-light"
        >
          {coda.copyAction}
        </button>
      </p>
      <p aria-live="polite" data-copy-status class="mt-2 min-h-6 text-sm text-ink-on-light"></p>
    </div>
  </Section>
</Layout>
