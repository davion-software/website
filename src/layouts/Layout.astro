---
import { Font } from "astro:assets";
import Lockup from "../components/Lockup.astro";
import { brand, home, links, nav } from "../content/home";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${brand.name} — Estudio de software independiente en Perú`,
  description = home.oneLiner,
} = Astro.props;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_PE" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-inter" preload />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
    <body class="min-h-dvh bg-davion-black font-sans text-soft-white">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-steel focus:px-4 focus:py-3 focus:text-sm focus:font-medium"
    >
      Saltar al contenido
    </a>
    <header class="border-b border-line">
      <div
        class="mx-auto flex w-full max-w-6xl flex-col gap-4 px-6 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-8"
      >
        <Lockup />
        <nav
          aria-label="Principal"
          class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-medium"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="text-ink-secondary transition-colors duration-150 hover:text-soft-white"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="border-t border-line">
      <div
        class="mx-auto flex w-full max-w-6xl flex-col gap-4 px-6 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-8"
      >
        <Lockup />
        <div class="flex flex-col gap-2 text-sm sm:items-end">
          <p class="text-ink-secondary">{home.footerStudio}</p>
          <p class="flex items-center gap-3">
            <span class="text-ink-tertiary">© {year} Davion Software</span>
            <a
              href={links.github}
              rel="me noopener"
              class="text-ink-secondary underline-offset-4 transition-colors duration-150 hover:text-soft-white hover:underline"
            >
              GitHub</a
            >
          </p>
        </div>
      </div>
    </footer>
    <script>
      const revealables = document.querySelectorAll(".reveal");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.setAttribute("data-visible", "");
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -15% 0px", threshold: 0 },
      );
      revealables.forEach((element) => observer.observe(element));
    </script>
  </body>
</html>
