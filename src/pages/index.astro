---
import Button from "../components/Button.astro";
import CapabilityIconGlyph from "../components/CapabilityIconGlyph.astro";
import FaqList from "../components/FaqList.astro";
import Founder from "../components/Founder.astro";
import Layout from "../layouts/Layout.astro";
import Projects from "../components/Projects.astro";
import Section from "../components/Section.astro";
import Testimonials from "../components/Testimonials.astro";
import TaglineReveal from "../components/TaglineReveal.astro";
import {
  brand,
  capabilities,
  capabilitiesHeading,
  coda,
  faq,
  faqHeading,
  founder,
  home,
  links,
  principles,
  process,
  processHeading,
  tagline,
} from "../content/home";

export const prerender = true;

const faqSchema = {
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const siteUrl = "https://davionsoftware.com";
const orgSchema = {
  "@type": "ProfessionalService",
  name: brand.name,
  url: siteUrl,
  email: links.emailAddress,
  telephone: "+51996004562",
  logo: `${siteUrl}/favicon.png`,
  image: `${siteUrl}/og.png`,
  description: home.oneLiner,
  areaServed: "PE",
  address: { "@type": "PostalAddress", addressCountry: "PE" },
  sameAs: [links.github],
  ...(founder.enabled && {
    founder: {
      "@type": "Person",
      name: founder.name,
      jobTitle: founder.role,
      url: founder.links[2].href,
      sameAs: [founder.links[0].href, founder.links[1].href],
    },
  }),
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [orgSchema, faqSchema],
};
---

<Layout>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Section tone="base" compact>
    <div class="flex flex-col pt-8 pb-12 md:pt-16 md:pb-24">
      <p class="flex items-center gap-2 text-sm text-ink-tertiary">
        <span aria-hidden="true" class="inline-block size-2 rounded-full bg-accent"></span>
        {home.availability}
      </p>
      <h1
        class="mt-6 flex max-w-5xl flex-col gap-3 text-title leading-none font-medium tracking-tight md:text-display lg:text-hero"
      >
        <span class="text-balance">{home.heroLead}</span>
        <span class="text-balance text-ink-secondary">{home.heroTail}</span>
      </h1>
      <p class="mt-8 max-w-xl text-lg text-pretty text-ink-secondary">
        {home.oneLiner}
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        {
          links.calendar ? (
            <>
              <Button variant="primary" href={links.calendar} rel="noopener noreferrer" target="_blank">
                {home.primaryCta}
              </Button>
              <Button variant="secondary" href={links.whatsappDiagnostic} rel="noopener noreferrer" target="_blank">
                {home.whatsappCta}
              </Button>
            </>
          ) : (
            <>
              <Button variant="primary" href={links.whatsappDiagnostic} rel="noopener noreferrer" target="_blank">
                {home.primaryCta}
              </Button>
              <Button variant="secondary" href="#capacidades">
                {home.capabilitiesCta}
              </Button>
            </>
          )
        }
      </div>
      <p class="mt-4 max-w-xl text-sm text-pretty text-ink-tertiary">
        {home.heroProof}
      </p>
    </div>
  </Section>

  <TaglineReveal
    heading={tagline.heading}
    support={tagline.support}
    columns={tagline.columns}
    rows={tagline.rows}
  />

  <Section id="capacidades" tone="base">
    <h2 class="text-heading leading-tight font-medium tracking-tight md:text-title">
      {capabilitiesHeading}
    </h2>
    <ul class="reveal mt-12 grid gap-4 md:grid-cols-2">
      {
        capabilities.map((capability, index) => {
          const wide = index === capabilities.length - 1 && capabilities.length % 2 === 1;
          return (
            <li
              data-reveal-item
              class:list={[
                "flex flex-col rounded-xl border border-border bg-(--card-bg) p-6",
                wide && "md:col-span-2 md:grid md:grid-cols-2 md:gap-x-12",
              ]}
            >
              <div class:list={["contents", wide && "md:block"]}>
                <CapabilityIconGlyph name={capability.icon} />
                <h3 class="mt-4 text-lg font-semibold tracking-tight text-ink">
                  {capability.name}
                </h3>
                <p class="mt-3 text-base text-pretty text-ink">
                  {capability.pain}
                </p>
              </div>
              <div class:list={["contents", wide && "md:block"]}>
                <p
                  class:list={[
                    "mt-3 text-base text-pretty text-ink-secondary",
                    wide && "md:mt-12",
                  ]}
                >
                  {capability.delivery}
                </p>
                {capability.tools.length > 0 && (
                  <ul aria-label="Herramientas" class="mt-auto flex flex-wrap gap-2 pt-4">
                    {capability.tools.map((tool) => (
                      <li class="rounded-full border border-border px-3 py-1 text-sm text-ink-secondary">
                        {tool}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
  </Section>

  <Section id="como-trabajamos" tone="raised">
    <h2 class="text-heading leading-tight font-medium tracking-tight md:text-title">
      {processHeading}
    </h2>
    <ol class="reveal mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        process.map((step, index) => (
          <li
            data-reveal-item
            class="flex flex-col rounded-xl border border-border bg-(--card-bg) p-6"
          >
            <span aria-hidden="true" class="text-sm font-medium tracking-widest text-accent">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-4 text-lg font-semibold tracking-tight text-ink">
              {step.title}
            </h3>
            <p class="mt-3 text-base text-pretty text-ink-secondary">
              {step.description}
            </p>
            <p class="mt-auto pt-4 text-base text-ink">
              <span class="font-semibold">Usted recibe:</span> {step.receive}
            </p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Projects tone="base" />

  <Section id="estudio" tone="base">
    <h2 class="max-w-2xl text-heading leading-tight font-medium tracking-tight text-balance md:text-title">
      {home.who}
    </h2>
    <p class="mt-6 max-w-2xl text-lg text-pretty text-ink-secondary">
      {home.studioBody}
    </p>
    <ul class="reveal mt-12 grid gap-8 md:grid-cols-3">
      {
        principles.map((principle) => (
          <li data-reveal-item class="border-t border-border pt-6">
            <h3 class="text-lg font-semibold tracking-tight text-ink">
              {principle.title}
            </h3>
            <p class="mt-2 text-base text-pretty text-ink-secondary">
              {principle.description}
            </p>
          </li>
        ))
      }
    </ul>
    <Founder />
  </Section>

  <Testimonials tone="raised" />

  <Section id="preguntas" tone="raised">
    <h2 class="max-w-2xl text-heading leading-tight font-medium tracking-tight text-balance md:text-title">
      {faqHeading}
    </h2>
    <FaqList items={faq} />
  </Section>

  <Section id="contacto" tone="light">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-start lg:gap-16">
      <div>
        <p class="flex items-center gap-2 text-sm text-ink-on-light-secondary">
          <span aria-hidden="true" class="inline-block size-2 rounded-full bg-accent"></span>
          {home.availability}
        </p>
        <h2 class="mt-6 text-heading leading-tight font-medium tracking-tight text-balance md:text-title">
          {coda.heading}
        </h2>
        <p class="mt-6 max-w-xl text-lg text-pretty text-ink-on-light-secondary">
          {coda.support}
        </p>
        <p class="mt-8 text-sm font-medium tracking-widest text-ink-on-light-secondary uppercase">
          {coda.stepsLabel}
        </p>
        <ol class="mt-4 flex flex-col gap-3">
          {
            coda.steps.map((step, index) => (
              <li class="flex items-start gap-3 text-base text-pretty text-ink-on-light">
                <span
                  aria-hidden="true"
                  class="inline-flex size-6 shrink-0 items-center justify-center rounded-full border border-border-strong-light text-sm font-medium"
                >
                  {index + 1}
                </span>
                <span class="pt-px">{step}</span>
              </li>
            ))
          }
        </ol>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button
            variant="primary"
            href={links.whatsappDiagnostic}
            rel="noopener noreferrer"
            target="_blank"
          >
            {home.whatsappCta}
          </Button>
          {
            links.calendar && (
              <Button
                variant="secondary"
                surface="light"
                href={links.calendar}
                rel="noopener noreferrer"
                target="_blank"
              >
                {coda.calendarAction}
              </Button>
            )
          }
        </div>
      </div>

      <div class="rounded-xl border border-border-light bg-wash-on-light p-6 md:p-8">
        <h3 class="text-lg font-semibold tracking-tight text-ink-on-light">{coda.directHeading}</h3>
        <p class="mt-2 text-base text-pretty text-ink-on-light-secondary">{coda.directBody}</p>

        <div class="mt-6 border-t border-border-light pt-6">
          <p class="text-sm text-ink-on-light-secondary">{coda.emailLabel}</p>
          <div class="mt-1 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
            <a
              href={links.email}
              class="inline-flex min-h-11 items-center text-lg font-semibold break-words text-ink-on-light underline decoration-border-strong-light underline-offset-4"
            >
              {links.emailAddress}
            </a>
            <button
              type="button"
              data-copy-email={links.emailAddress}
              data-copied={coda.copied}
              data-failed={coda.copyFailed}
              class="js-only btn-secondary-on-light h-11 items-center gap-2 rounded-lg border border-border-strong-light px-4 text-sm font-semibold text-ink-on-light transition-[background-color,transform] duration-150 ease-out-quart active:scale-[0.96]"
            >
              <svg
                aria-hidden="true"
                focusable="false"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-4"
              >
                <path data-copy-icon="idle" d="M8 8h12v12H8V8Zm-4 8V4h12" />
                <path data-copy-icon="done" d="m5 12.5 4.5 4.5L19 7.5" class="hidden" />
              </svg>
              <span data-copy-label>{coda.copyAction}</span>
            </button>
          </div>
        </div>

        <div class="mt-6 border-t border-border-light pt-6">
          <p class="text-sm text-ink-on-light-secondary">{coda.phoneLabel}</p>
          <a
            href={links.whatsapp}
            rel="noopener noreferrer"
            target="_blank"
            class="mt-1 inline-flex min-h-11 items-center text-lg font-semibold text-ink-on-light underline decoration-border-strong-light underline-offset-4"
          >
            {coda.phoneDisplay}
          </a>
        </div>
        <p aria-live="polite" data-copy-status class="sr-only"></p>
      </div>
    </div>
  </Section>
</Layout>
