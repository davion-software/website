---
import type { TaglineIcon } from "../content/home";

interface Props {
  lines: readonly string[];
  support: string;
  before: { label: string; items: readonly { icon: TaglineIcon; text: string }[] };
  after: { label: string; items: readonly string[] };
}

const { lines, support, before, after } = Astro.props;
const lead = lines[0] ?? "";
const tail = lines[1] ?? "";

function iconPath(icon: TaglineIcon): string {
  switch (icon) {
    case "sheet":
      return "M4 4h16v16H4V4Zm0 5.5h16M4 15h16M9.5 4v16";
    case "chat":
      return "M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z";
    case "copy":
      return "M8 8h12v12H8V8Zm-4 8V4h12";
    case "clock":
      return "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-13v4.5l3 2";
    default: {
      const _exhaustive: never = icon;
      return _exhaustive;
    }
  }
}
---

<section class="bg-surface-1" aria-labelledby="tagline-heading">
  <div id="tagline" class="tagline mx-auto w-full max-w-6xl px-6 py-16 sm:px-8 md:py-24">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end lg:gap-12">
      <h2 id="tagline-heading" class="flex flex-col gap-6 tracking-tight">
        <span
          class="tagline-before text-heading leading-tight font-medium text-balance md:text-title"
        >
          <span class="tagline-before-copy">{lead}</span>
        </span>
        {
          tail && (
            <span class="tagline-after text-title leading-none font-medium text-balance lg:text-display">
              {tail}
            </span>
          )
        }
      </h2>
      <p class="max-w-xl text-lg text-pretty text-ink-secondary">{support}</p>
    </div>

    <div class="mt-12 grid gap-4 md:mt-16 md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] md:items-stretch">
      <div class="rounded-xl border border-dashed border-border-strong/60 p-6">
        <p class="text-sm font-medium tracking-widest text-ink-tertiary uppercase">
          {before.label}
        </p>
        <ul class="mt-6 flex flex-col gap-4">
          {
            before.items.map((item, index) => (
              <li class="tagline-chore flex items-start gap-3" style={`--i: ${index}`}>
                <svg
                  aria-hidden="true"
                  focusable="false"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="mt-0.5 size-5 shrink-0 text-ink-tertiary"
                >
                  <path d={iconPath(item.icon)} />
                </svg>
                <span class="text-base text-pretty text-ink-secondary">
                  <span class="tagline-chore-copy">{item.text}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div aria-hidden="true" class="tagline-arrow flex items-center justify-center">
        <span class="inline-flex size-10 items-center justify-center rounded-full border border-border bg-surface-2">
          <svg
            focusable="false"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-5 rotate-90 text-accent md:rotate-0"
          >
            <path d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </span>
      </div>

      <div class="rounded-xl border border-border bg-surface-2 p-6">
        <p class="text-sm font-medium tracking-widest text-accent uppercase">{after.label}</p>
        <ul class="mt-6 flex flex-col gap-4">
          {
            after.items.map((item, index) => (
              <li class="tagline-gain flex items-start gap-3" style={`--i: ${index}`}>
                <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-accent text-on-accent">
                  <svg
                    aria-hidden="true"
                    focusable="false"
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-3"
                  >
                    <path d="m5 12.5 4.5 4.5L19 7.5" />
                  </svg>
                </span>
                <span class="text-base text-pretty text-ink">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
