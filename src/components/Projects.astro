---
import { projects, projectsHeading } from "../content/home";
import Section from "./Section.astro";

interface Props {
  tone?: "base" | "raised";
}

const { tone = "base" } = Astro.props;
---

{
  projects.length > 0 && (
    <Section id="proyectos" tone={tone}>
      <h2 class="text-heading leading-tight font-medium tracking-tight md:text-title">
        {projectsHeading}
      </h2>
      <ul class="reveal mt-12 grid gap-4 md:grid-cols-2">
        {projects.map((project) => (
          <li
            data-reveal-item
            class="flex flex-col rounded-xl border border-border bg-(--card-bg) p-6"
          >
            <h3 class="text-lg font-semibold tracking-tight text-ink">{project.name}</h3>
            <p class="mt-3 text-base text-pretty text-ink-secondary">{project.summary}</p>
            {project.href && (
              <a
                href={project.href}
                rel="noopener"
                class="link-quiet mt-auto inline-flex min-h-11 items-center pt-4 text-sm font-medium text-ink-secondary underline underline-offset-4"
              >
                {project.name}
              </a>
            )}
          </li>
        ))}
      </ul>
    </Section>
  )
}
