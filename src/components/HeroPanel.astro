---
interface Props {
  uid: string;
}

const { uid } = Astro.props;
const glowId = `${uid}-glow`;
const shadowId = `${uid}-shadow`;

const rows = [
  { title: "#1042 · F. Ruiz", note: "Cotización enviada", tone: "idle", label: "Pendiente" },
  { title: "#1043 · Lima Sur", note: "Asignado a Ana", tone: "active", label: "En curso" },
  { title: "#1044 · Andina", note: "Entregado 10:42", tone: "done", label: "Listo" },
] as const;
---

<defs>
  <radialGradient id={glowId} cx="0.5" cy="0.5" r="0.5">
    <stop offset="0" stop-color="var(--color-accent)" stop-opacity="0.16"></stop>
    <stop offset="1" stop-color="var(--color-accent)" stop-opacity="0"></stop>
  </radialGradient>
  <filter id={shadowId} x="-20%" y="-30%" width="140%" height="180%">
    <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#000" flood-opacity="0.5"></feDropShadow>
  </filter>
</defs>

<g transform="translate(214 31)">
  <ellipse cx="140" cy="100" rx="150" ry="130" fill={`url(#${glowId})`}></ellipse>
  <rect width="266" height="198" rx="12" class="fill-surface-1 stroke-steel" />
  <path
    d="M12 0h40v198H12a12 12 0 0 1-12-12V12A12 12 0 0 1 12 0Z"
    class="fill-surface-0"
  ></path>

  <rect x="15" y="16" width="22" height="22" rx="6" class="fill-accent"></rect>
  <rect x="9" y="50" width="34" height="24" rx="6" class="fill-accent/15"></rect>
  <path
    d="M19 57h14M19 62h14M19 67h9"
    fill="none"
    stroke-width="2"
    stroke-linecap="round"
    class="stroke-accent"
  ></path>
  <rect x="18" y="92" width="3" height="6" rx="1" class="fill-ink/35"></rect>
  <rect x="24.5" y="88" width="3" height="10" rx="1" class="fill-ink/35"></rect>
  <rect x="31" y="85" width="3" height="13" rx="1" class="fill-ink/35"></rect>
  <circle cx="26" cy="113" r="3.5" class="fill-ink/35"></circle>
  <path d="M19.5 124a6.5 6.5 0 0 1 13 0" fill="none" stroke-width="2" class="stroke-ink/35"></path>

  <text x="70" y="29" font-size="13" font-weight="600" class="fill-ink">Pedidos</text>
  <text x="70" y="43" font-size="9" class="fill-ink/50">Martes · 3 activos</text>
  <text x="254" y="27" font-size="8.5" text-anchor="end" class="hero-panel-before fill-ink/55">1 de 3 listos</text>
  <text x="254" y="27" font-size="8.5" text-anchor="end" class="hero-panel-after fill-ink/55">2 de 3 listos</text>
  <rect x="194" y="34" width="60" height="4" rx="2" class="fill-steel"></rect>
  <rect x="194" y="34" width="40" height="4" rx="2" class="hero-panel-progress fill-accent"></rect>

  {
    rows.map((row, index) => {
      const y = 54 + index * 46;
      const changes = row.tone === "active";
      return (
        <g>
          <rect x="70" y={y} width="184" height="38" rx="8" class="fill-surface-0/60 stroke-steel" />
          {changes && (
            <rect x="70" y={y} width="184" height="38" rx="8" fill="none" class="hero-panel-flash stroke-accent" />
          )}
          <text x="82" y={y + 16} font-size="10" font-weight="600" class="fill-ink/90">
            {row.title}
          </text>
          <text x="82" y={y + 29} font-size="8.5" class:list={["fill-ink/45", changes && "hero-panel-before"]}>
            {row.note}
          </text>

          {row.tone === "idle" && (
            <g>
              <rect x="180" y={y + 8} width="66" height="22" rx="11" class="fill-steel" />
              <text x="213" y={y + 22.5} font-size="10" font-weight="600" text-anchor="middle" class="fill-ink/70">
                {row.label}
              </text>
            </g>
          )}
          {changes && (
            <g class="hero-panel-before">
              <rect x="180" y={y + 8} width="66" height="22" rx="11" class="fill-accent/25" />
              <text x="213" y={y + 22.5} font-size="10" font-weight="600" text-anchor="middle" class="fill-accent">
                {row.label}
              </text>
            </g>
          )}
          {row.tone !== "idle" && (
            <g class:list={[changes && "hero-panel-after"]}>
              {changes && (
                <text x="82" y={y + 29} font-size="8.5" class="fill-ink/45">
                  Entregado 11:05
                </text>
              )}
              <rect x="180" y={y + 8} width="66" height="22" rx="11" class="fill-accent" />
              <path
                d={`M196.5 ${y + 19}l2.5 2.5 4.5-5`}
                fill="none"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="stroke-on-accent"
              />
              <text x="218" y={y + 22.5} font-size="10" font-weight="600" text-anchor="middle" class="fill-on-accent">
                Listo
              </text>
            </g>
          )}
        </g>
      );
    })
  }

  <g transform="translate(118 178)">
    <g class="hero-panel-toast">
      <rect width="142" height="32" rx="10" class="fill-surface-2 stroke-border-strong/60" filter={`url(#${shadowId})`} />
      <circle cx="16" cy="16" r="8" class="fill-accent/20"></circle>
      <path
        d="M12.5 18.5h7l-1-1.5v-3a2.5 2.5 0 0 0-5 0v3Zm2.5 2h2"
        fill="none"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="stroke-accent"
      ></path>
      <text x="30" y="14" font-size="9" font-weight="600" class="fill-ink">Aviso enviado a Ana</text>
      <text x="30" y="25" font-size="8" class="fill-ink/55">Pedido #1043 entregado</text>
    </g>
  </g>
</g>

<style>
  /* Final state is the default; the load animation only plays when motion is allowed. */
  .hero-panel-before {
    opacity: 0;
  }

  .hero-panel-flash {
    opacity: 0;
  }

  .hero-panel-progress {
    transform-box: fill-box;
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-panel-before {
      animation: hero-panel-out 0.3s var(--ease-out-quart) 1.4s both;
    }

    .hero-panel-after {
      animation: hero-panel-in 0.3s var(--ease-out-quart) 1.4s both;
    }

    .hero-panel-flash {
      animation: hero-panel-flash 1.2s var(--ease-out-quart) 1.4s both;
    }

    .hero-panel-progress {
      animation: hero-panel-grow 0.5s var(--ease-out-quart) 1.4s both;
    }

    .hero-panel-toast {
      animation: hero-panel-toast 0.4s var(--ease-out-quart) 1.9s both;
    }
  }

  @keyframes hero-panel-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes hero-panel-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes hero-panel-flash {
    0% {
      opacity: 0;
    }
    25% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes hero-panel-grow {
    from {
      transform: scaleX(0.5);
    }
    to {
      transform: none;
    }
  }

  @keyframes hero-panel-toast {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
