---
import { testimonials, testimonialsHeading } from "../content/home";
import Section from "./Section.astro";

interface Props {
  tone?: "base" | "raised";
}

const { tone = "raised" } = Astro.props;
---

{
  testimonials.length > 0 && (
    <Section id="testimonios" tone={tone}>
      <h2 class="text-heading leading-tight font-medium tracking-tight md:text-title">
        {testimonialsHeading}
      </h2>
      <ul class="reveal mt-12 grid gap-4 md:grid-cols-2">
        {testimonials.map((item) => (
          <li
            data-reveal-item
            class="rounded-xl border border-border bg-(--card-bg) p-6"
          >
            <figure>
              <blockquote class="text-lg text-pretty text-ink">{item.quote}</blockquote>
              <figcaption class="mt-4 text-sm text-ink-secondary">
                {item.author}, {item.role}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </Section>
  )
}
