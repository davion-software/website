---
import Layout from "../layouts/Layout.astro";
import { capabilities, home } from "../content/home";
---

<Layout>
  <section class="mx-auto max-w-6xl px-5 pb-16 pt-16 sm:px-8 sm:pb-24 sm:pt-24 lg:pt-28">
    <h1
      class="max-w-4xl text-[2rem] font-medium leading-[1.15] tracking-tight text-soft-white sm:text-5xl lg:text-6xl"
    >
      {home.hero}
    </h1>
    <p
      class="mt-8 max-w-2xl text-lg leading-relaxed text-soft-white sm:text-xl"
    >
      {home.oneLiner}
    </p>
  </section>

  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="h-px bg-gold"></div>
  </div>

  <section
    id="estudio"
    class="mx-auto grid max-w-6xl gap-6 px-5 py-16 sm:px-8 lg:grid-cols-12 lg:gap-12 lg:py-20"
  >
    <h2
      class="text-xs font-medium tracking-[0.28em] text-gold uppercase lg:col-span-4"
    >
      Estudio
    </h2>
    <p class="max-w-2xl text-lg leading-relaxed text-soft-white lg:col-span-8">
      {home.who}
    </p>
  </section>

  <section
    id="para-quien"
    class="mx-auto grid max-w-6xl gap-6 px-5 pb-16 sm:px-8 lg:grid-cols-12 lg:gap-12 lg:pb-20"
  >
    <h2
      class="text-xs font-medium tracking-[0.28em] text-gold uppercase lg:col-span-4"
    >
      Para quién
    </h2>
    <div class="max-w-2xl lg:col-span-8">
      <p class="text-lg leading-relaxed text-soft-white">{home.audienceLead}</p>
      <p class="mt-4 text-lg leading-relaxed text-soft-white">
        {home.audienceDetail}
      </p>
    </div>
  </section>

  <section
    id="capacidades"
    class="border-t border-steel"
  >
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-20">
      <h2 class="text-xs font-medium tracking-[0.28em] text-gold uppercase">
        Capacidades
      </h2>
      <ol
        class="mt-10 grid gap-px bg-steel sm:grid-cols-2 xl:grid-cols-4"
      >
        {
          capabilities.map((capability, index) => (
            <li class="bg-charcoal p-6 sm:p-8">
              <p class="text-xs font-medium tracking-[0.22em] text-gold">
                {String(index + 1).padStart(2, "0")}
              </p>
              <h3 class="mt-5 text-lg font-medium tracking-tight text-soft-white">
                {capability.name}
              </h3>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-soft-white">
                {capability.description}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>
