---
import Button from "../components/Button.astro";
import Layout from "../layouts/Layout.astro";
import { capabilities, coda, home, links, principles } from "../content/home";

export const prerender = true;
---

<Layout>
  <section class="lg:flex lg:min-h-[calc(100dvh-4.5rem)] lg:items-center">
    <div
      class="mx-auto flex w-full max-w-6xl justify-center px-6 pt-16 pb-20 sm:px-8 sm:pt-20 lg:py-16"
    >
      <div class="flex max-w-[52rem] flex-col items-center text-center">
        <p class="rise flex items-center gap-2.5 text-sm text-ink-tertiary">
          <span
            aria-hidden="true"
            class="inline-block size-1.5 rounded-full bg-gold"></span>
          {home.availability}
        </p>
        <h1
          class="rise rise-2 mt-5 max-w-[22ch] text-[2.75rem] leading-[1.05] font-medium tracking-tight text-balance sm:text-6xl lg:text-7xl"
        >
          {home.heroLead}{" "}<span class="text-ink-secondary">{home.heroTail}</span>
        </h1>
        <p
          class="rise rise-3 mt-6 max-w-[42rem] text-base leading-relaxed text-pretty text-ink-secondary sm:mt-8 sm:text-xl"
        >
          {home.oneLiner}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3 sm:mt-10">
          <Button variant="primary" href="#contacto">{home.primaryCta}</Button>
          <Button variant="secondary" href="#capacidades">
            {home.secondaryCta}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <section
    id="estudio"
    class="mx-auto w-full max-w-6xl scroll-mt-24 px-6 py-12 sm:px-8 lg:py-16"
  >
    <h2
      class="max-w-[24ch] text-2xl leading-snug font-medium tracking-tight text-balance sm:text-3xl"
    >
      {home.who}
    </h2>
    <p
      class="mt-6 max-w-[36rem] text-lg leading-relaxed text-pretty text-ink-secondary"
    >
      {home.audienceLead}{" "}{home.audienceDetail}
    </p>
    <p
      class="mt-4 max-w-[36rem] text-base leading-relaxed text-pretty text-ink-secondary"
    >
      {home.audienceBridge}
    </p>
    <dl class="mt-14 grid gap-10 sm:grid-cols-3 sm:gap-8 lg:mt-16">
      {
        principles.map((principle) => (
          <div>
            <dt class="text-base font-medium text-soft-white">
              {principle.title}
            </dt>
            <dd class="mt-2 text-sm leading-relaxed text-pretty text-ink-secondary">
              {principle.description}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section
    id="capacidades"
    class="mx-auto w-full max-w-6xl scroll-mt-24 px-6 py-12 sm:px-8 lg:py-16"
  >
    <h2 class="text-2xl font-medium tracking-tight sm:text-3xl">
      Capacidades
    </h2>
    <ol class="reveal mt-10">
      {
        capabilities.map((capability) => (
          <li
            data-reveal-item
            class="grid gap-3 border-t border-line py-8 lg:grid-cols-12 lg:gap-16 lg:py-10"
          >
            <h3 class="text-xl font-medium tracking-tight text-soft-white sm:text-2xl lg:col-span-5">
              {capability.name}
            </h3>
            <p class="max-w-[36rem] text-base leading-relaxed text-pretty text-ink-secondary lg:col-span-7 lg:pt-1">
              {capability.description}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="contacto" class="scroll-mt-24 bg-soft-white text-charcoal">
    <div class="mx-auto w-full max-w-6xl px-6 py-20 sm:px-8 lg:py-28">
      <div class="max-w-[44rem]">
        <h2
          class="text-3xl leading-tight font-medium tracking-tight text-balance sm:text-5xl sm:leading-[1.08]"
        >
          {coda.headingLead}{" "}<span class="text-ink-on-light-secondary">{coda.headingTail}</span>
        </h2>
        <p
          class="mt-8 max-w-prose text-lg leading-relaxed text-pretty text-ink-on-light-secondary"
        >
          {coda.support}
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <Button
            variant="primary"
            href={links.whatsapp}
            rel="noopener noreferrer"
            target="_blank"
          >
            {coda.action}
          </Button>
          <Button variant="secondary" surface="light" href={links.email}>
            {coda.emailAction}
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>
