---
import Mark from "../assets/mark.svg";
import { brand } from "../content/home";

interface Props {
  href?: string;
}

const { href = "/" } = Astro.props;
---

<a href={href} aria-label={`${brand.name}, inicio`} class="inline-flex min-h-11 items-center gap-3 no-underline">
  <Mark aria-hidden="true" focusable="false" width={36} height={36} class="size-9 shrink-0" />
  <span class="flex flex-col leading-none">
    <span class="font-medium tracking-tight text-ink">{brand.lockupWordmark}</span>{" "}
    <span class="mt-1 text-sm font-medium tracking-[0.28em] text-accent">
      {brand.lockupCategory}
    </span>
  </span>
</a>
