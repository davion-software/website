---
interface Props {
  heading: string;
  support: string;
  columns: { heard: string; fix: string };
  rows: readonly { heard: string; fix: string }[];
}

const { heading, support, columns, rows } = Astro.props;
const grid = "md:grid md:grid-cols-2 md:gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]";
---

<section class="bg-surface-1" aria-labelledby="tagline-heading">
  <div id="tagline" class="tagline mx-auto w-full max-w-6xl px-6 py-16 sm:px-8 md:py-24">
    <div class:list={["tagline-intro flex flex-col gap-6 md:items-end", grid]}>
      <h2
        id="tagline-heading"
        class="text-title leading-none font-medium tracking-tight text-balance lg:text-display"
      >
        {heading}
      </h2>
      <p class="max-w-xl text-lg text-pretty text-ink-secondary">{support}</p>
    </div>

    <div class="mt-12 md:mt-16">
      <div
        class:list={[
          "tagline-intro hidden pb-4 text-sm font-medium tracking-widest uppercase md:grid",
          grid,
        ]}
      >
        <p class="text-ink-tertiary">{columns.heard}</p>
        <p class="text-accent">{columns.fix}</p>
      </div>

      <ul>
        {
          rows.map((row, index) => (
            <li class:list={["tagline-row relative flex flex-col gap-3 py-6 md:items-baseline", grid]} style={`--i: ${index}`}>
              <span aria-hidden="true" class="tagline-rule absolute inset-x-0 top-0 h-px bg-border" />
              <p class="tagline-heard text-lg text-pretty md:text-heading md:leading-snug">
                <span class="sr-only">{columns.heard}: </span>“{row.heard}”
              </p>
              <p class="tagline-fix flex items-baseline gap-3 text-base text-pretty text-ink md:text-lg">
                <span aria-hidden="true" class="tagline-arrow text-accent">→</span>
                <span>
                  <span class="sr-only">{columns.fix}: </span>
                  {row.fix}
                </span>
              </p>
            </li>
          ))
        }
      </ul>
      <div aria-hidden="true" class="tagline-rule h-px bg-border" style={`--i: ${rows.length}`}></div>
    </div>
  </div>
</section>
