---
import { Image } from "astro:assets";
import portrait from "../assets/founder.jpg";
import { founder } from "../content/home";
---

{
  founder.enabled && (
    <div class="mt-16 flex flex-col gap-6 rounded-xl border border-border bg-surface-1 p-6 sm:flex-row sm:items-center">
      <Image
        src={portrait}
        alt={founder.photoAlt}
        width={112}
        height={112}
        densities={[1, 2]}
        loading="lazy"
        class="size-28 shrink-0 rounded-full"
      />
      <div>
        <h3 class="text-lg font-medium tracking-tight text-ink">
          {founder.heading}
        </h3>
        <p class="mt-2 text-base text-ink">
          <span class="font-medium">{founder.name}</span>
          <span class="text-ink-secondary">, {founder.role}</span>
        </p>
        <p class="mt-2 max-w-xl text-base leading-relaxed text-pretty text-ink-secondary">
          {founder.statement}
        </p>
        <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-1">
          {founder.links.map((link) => (
            <li>
              <a
                href={link.href}
                rel="noopener"
                class="link-quiet inline-flex min-h-11 items-center text-sm font-medium text-ink-secondary underline underline-offset-4"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )
}
