---
import HeroPanel from "./HeroPanel.astro";

const sheetColumns = [
  { label: "Cliente", x: 16 },
  { label: "Pedido", x: 84 },
  { label: "Estado", x: 134 },
];
const sheetRows = [
  ["F. Ruiz", "#1042", "¿pagó?"],
  ["Lima Sur", "#1043", "ver chat"],
  ["F. Ruiz", "#1042", "¿?"],
];
---

<div aria-hidden="true" class="w-full max-w-md lg:max-w-none">
  <svg
    viewBox="0 0 480 260"
    width="480"
    height="260"
    class="hidden aspect-[480/260] h-auto w-full md:block"
    focusable="false"
  >
    <g transform="rotate(-5 96 98)">
      <rect x="10" y="34" width="172" height="128" rx="6" class="fill-surface-1 stroke-steel" />
      <rect x="10" y="34" width="172" height="20" rx="6" class="fill-steel/60"></rect>
      <rect x="17" y="40" width="8" height="8" rx="1.5" class="fill-davion-gray"></rect>
      <text x="30" y="47" font-size="7.5" class="fill-ink/60">pedidos_final_v3 (copia).xlsx</text>
      <line x1="78" y1="54" x2="78" y2="162" class="stroke-steel"></line>
      <line x1="128" y1="54" x2="128" y2="162" class="stroke-steel"></line>
      {
        [70, 91, 112, 133].map((y) => (
          <line x1="10" y1={y} x2="182" y2={y} class="stroke-steel" />
        ))
      }
      {
        sheetColumns.map((column) => (
          <text x={column.x} y="65" font-size="7" font-weight="600" class="fill-ink/40">
            {column.label}
          </text>
        ))
      }
      {
        sheetRows.map((cells, row) =>
          cells.map((cell, col) => (
            <text x={sheetColumns[col]?.x} y={84 + row * 21} font-size="8" class="fill-ink/55">
              {cell}
            </text>
          ))
        )
      }
      <rect x="16" y="144" width="30" height="4" rx="2" class="fill-ink/15"></rect>
      <rect x="84" y="144" width="20" height="4" rx="2" class="fill-ink/15"></rect>
      <rect
        x="12.5"
        y="114.5"
        width="167"
        height="16"
        rx="3"
        stroke-dasharray="3 2"
        class="fill-accent/5 stroke-accent/70"
      ></rect>
    </g>

    <g transform="rotate(3 92 212)">
      <rect x="18" y="172" width="150" height="80" rx="12" class="fill-surface-1 stroke-steel" />
      <circle cx="34" cy="189" r="8" class="fill-steel"></circle>
      <text x="48" y="187" font-size="8.5" font-weight="600" class="fill-ink/85">Pedidos</text>
      <text x="48" y="197" font-size="7" class="fill-ink/45">Grupo · 12 personas</text>
      <rect x="130" y="182" width="28" height="14" rx="7" class="fill-accent"></rect>
      <text x="144" y="192" font-size="8" font-weight="700" text-anchor="middle" class="fill-on-accent">214</text>
      <rect x="28" y="206" width="90" height="18" rx="8" class="fill-steel"></rect>
      <text x="36" y="218" font-size="7.5" class="fill-ink/75">¿Llegó lo de Ruiz?</text>
      <rect x="70" y="228" width="88" height="18" rx="8" class="fill-davion-gray/35"></rect>
      <text x="78" y="240" font-size="7.5" class="fill-ink/75">Está en el Excel</text>
    </g>

    <g transform="rotate(6 150 21)">
      <rect x="100" y="8" width="104" height="26" rx="12" class="fill-steel/90 stroke-surface-0" />
      <text x="110" y="24" font-size="8" class="fill-ink/70">¿Cuál es la última?</text>
    </g>

    <path
      d="M188 130h18m-8-9 8 9-8 9"
      fill="none"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="stroke-accent"
    ></path>
    <HeroPanel uid="hero-panel-wide" />
  </svg>
  <svg
    viewBox="214 31 266 222"
    width="266"
    height="222"
    class="mx-auto aspect-[266/222] h-auto w-full max-w-[17rem] md:hidden"
    focusable="false"
  >
    <HeroPanel uid="hero-panel-narrow" />
  </svg>
</div>
